{
    "name": "hashieban/hashieban",
    "description": "WooCommerce profit and margin management plugin for Iranian online stores.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "psr-4": {
            "Hashieban\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "@php tests/run.php",
        "qa": "@php tools/qa.php",
        "release:check": "@php tools/release-audit.php",
        "release:build": "@php tools/build-release.php"
    }
}
